# As conexões do Nautilus agora ficam no arquivo YAML (veja nautilus.yaml.example),
# não mais em variáveis DATABASES__. Este .env guarda apenas:
#
# 1) O caminho do YAML (opcional; padrão: ./nautilus.yaml)
# NAUTILUS_CONFIG=./nautilus.yaml
#
# 2) Os SEGREDOS referenciados por ${VAR} dentro do YAML.
#    Cada ${VAR} do YAML precisa existir aqui (ou no ambiente do processo).
# PG_PROD_URL=postgresql://user:password@localhost:5432/mydb
# MYSQL_HOST=db.exemplo.com
# MYSQL_USER=app
# MYSQL_PASS=troque-me
# ORA_HOST=localhost
# ORA_USER=system
# ORA_PASS=troque-me
# MSSQL_HOST=localhost
# MSSQL_USER=sa
# MSSQL_PASS=troque-me
# MONGO_URL=mongodb://localhost:27017/
# REDIS_URL=redis://localhost:6379/0
