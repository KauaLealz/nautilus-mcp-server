# Configuração do Nautilus MCP Server.
# Copie para nautilus.yaml (ou aponte NAUTILUS_CONFIG para este caminho).
#
# Prefira gerir as conexões pelo CLI `nautilus` (add/edit/remove/list): ele
# cifra a senha na gravação. O campo `password` só é aceito cifrado (enc:...);
# texto puro e ${VAR} são recusados. A chave fica em NAUTILUS_KEY (gere com
# `nautilus keygen`) e precisa estar no ambiente do servidor para decifrar.
# Campos não-secretos (host/user/database/url) ainda aceitam ${VAR} do ambiente.

defaults:
  read_only: true           # padrão global; cada conexão pode sobrescrever
  query_timeout_ms: 30000   # timeout de statement (ms)
  connect_timeout_ms: 5000  # timeout para abrir a conexão (ms)
  max_rows: 200             # teto de linhas/documentos por chamada
  default_rows: 50          # padrão quando a tool não recebe limit
  query_max_length: 2000

connections:
  # --- URL única (escape hatch; o segredo embutido vem do ambiente) ---
  pg-prod:
    type: postgresql
    url: "${PG_PROD_URL}"
    read_only: true
    query_timeout_ms: 60000  # override por conexão (consultas pesadas)

  # --- Por componentes (senha cifrada, gravada por `nautilus add`) ---
  mysql-app:
    type: mysql              # 'mariadb' é aceito e normalizado para mysql
    host: "${MYSQL_HOST}"
    port: 3306
    user: "${MYSQL_USER}"
    password: "enc:gAAAAAB..."   # gerado pelo CLI — não edite à mão
    database: appdb
    read_only: false         # sobrescreve o default global

  oracle-rh:
    type: oracle
    host: "${ORA_HOST}"
    port: 1521
    user: "${ORA_USER}"
    password: "enc:gAAAAAB..."
    database: ORCLPDB1        # service name

  mssql-bi:
    type: sqlserver
    host: "${MSSQL_HOST}"
    port: 1433
    user: "${MSSQL_USER}"
    password: "enc:gAAAAAB..."
    database: BI

  mongo-events:
    type: mongodb
    url: "${MONGO_URL}"

  redis-cache:
    type: redis
    url: "${REDIS_URL}"
    socket_timeout_ms: 10000  # teto por operação (padrão = query_timeout_ms)

  # --- SQLite local (sem segredo) ---
  local-lite:
    type: sqlite
    path: "./data/app.db"     # ou url: "file:..." ou ":memory:"
